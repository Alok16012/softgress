{
  "name": "remotion",
  "private": true,
  "version": "0.1.0",
  "description": "Authored cinematics for the Softgress virtual HQ (rendered ahead of time, never per visitor).",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:intro": "remotion render src/index.ts Intro out/intro.mp4 --codec=h264 --crf=24 --scale=0.75 && remotion still src/index.ts Intro out/intro-poster.jpg --frame=200 --scale=0.75 --jpeg-quality=82",
    "render:intro-mobile": "remotion render src/index.ts IntroMobile out/intro-mobile.mp4 --codec=h264 --crf=24",
    "render:intro-webm": "remotion render src/index.ts Intro out/intro.webm --codec=vp9 --crf=34",
    "render:door": "remotion render src/index.ts DoorTransition out/door.mp4 --codec=h264 --crf=23",
    "render:rooftop": "remotion render src/index.ts RooftopFinale out/rooftop.mp4 --codec=h264 --crf=23",
    "render:title": "remotion render src/index.ts LogoTitle out/title.mp4 --codec=h264 --crf=20",
    "render:montage": "remotion render src/index.ts Montage out/montage.mp4 --codec=h264 --crf=23",
    "publish:media": "node scripts/publish-media.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@remotion/cli": "4.0.534",
    "@remotion/three": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3"
  }
}
