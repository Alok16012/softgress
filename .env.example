# Softgress Virtual HQ — environment template.
# Copy to .env.local for development. Every integration is optional: when a value is
# missing the feature runs in an honest, clearly labelled fallback (never faked).

# ── Site ──────────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:3000
# Production: set SITE_URL=https://softgress.com (falls back to it when unset in code).
# Search engine verification codes (optional, from Search Console / Bing Webmaster Tools)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── Database ──────────────────────────────────────────────────────────────────
# Unset → embedded PGlite (real Postgres in WASM) at .data/pglite, auto-migrated + seeded.
# Production: your Supabase Postgres connection string (transaction pooler, port 6543, is fine).
# DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# PGLITE_DATA_DIR=.data/pglite
# ALLOW_PGLITE_IN_PRODUCTION=false   # only for single-instance demos started with `pnpm start`
# DB_AUTO_MIGRATE=false              # apply migrations on boot when using DATABASE_URL
# DB_POOL_MAX=5

# ── AI guides ─────────────────────────────────────────────────────────────────
# Without a key the guides run in DEMO mode (retrieval + templates, labelled in the UI).
# ANTHROPIC_API_KEY=
AI_PROVIDER=auto            # auto | anthropic | demo
AI_MODEL=claude-opus-5-5    # verify with GET /api/health?model=1
AI_EFFORT=low               # low | medium | high (chat is latency-sensitive)
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_MS=45000

# ── Scheduling ────────────────────────────────────────────────────────────────
# none → visitors submit a preferred time, saved as "pending confirmation".
# mock → development-only slot picker backed by the DB (disabled in production).
CALENDAR_PROVIDER=none
CALENDAR_TIMEZONE=Asia/Kolkata

# ── Notifications ─────────────────────────────────────────────────────────────
# console → development outbox at /dev/outbox (never delivers; disabled in production).
# none    → no messages; status lookup explains that code delivery isn't configured.
NOTIFY_PROVIDER=console
# STAFF_ALERT_EMAIL=

# ── Public contact channels (shown only when set) ─────────────────────────────
CONTACT_EMAIL=info@softgress.com
WHATSAPP_NUMBER=+917447207700

# ── Security ──────────────────────────────────────────────────────────────────
# Required in production (>= 32 random chars): openssl rand -base64 48
# SESSION_SECRET=
# Admin sign-in. Production requires a scrypt hash: `pnpm admin:hash`
# ADMIN_EMAIL=owner@your-domain.com
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...
ADMIN_ROLE=owner            # owner | manager | viewer
# Development-only plaintext password (ignored when NODE_ENV=production).
# Local demo credentials (change them; never use in production):
# ADMIN_EMAIL=admin@softgress.local
# ADMIN_PASSWORD=demo-admin-local-only
# More admins: "email:role:scrypt$...;email2:role:scrypt$..."
# EXTRA_ADMINS=
# RATE_LIMIT_DISABLED=false
